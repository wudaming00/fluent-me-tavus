# Tavus stays server-side. Rotate any credential that has previously appeared
# in chat, logs, screenshots, or source control before placing it here.
TAVUS_API_KEY=

# Optional: reuse resources you already created. When TAVUS_FACE_ID is omitted,
# Fluent Me uses Lucas (Tavus stock Face r874cc5f8a3b).
TAVUS_PAL_ID=
TAVUS_FACE_ID=

# Optional public HTTPS webhook for Tavus post-call events.
TAVUS_CALLBACK_URL=

# Mirror voice: corrections are spoken in the learner's cloned voice outside
# the Tavus Face. Keep this key server-side too.
ELEVENLABS_API_KEY=
ELEVEN_TUTOR_VOICE=
ELEVEN_TTS_MODEL=eleven_flash_v2_5

# Fluent Me's language judge. Without this it can use a logged-in Claude CLI.
ANTHROPIC_API_KEY=

# Explicit local UI/demo development; never presented as live Tavus data.
FLUENTME_MOCK=
